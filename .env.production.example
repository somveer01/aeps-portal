# ── Copy this to `.env` on the server and fill in real secrets ──
# docker compose reads this file automatically.

# Database (a strong password — used by the postgres container + api)
PGUSER=aeps
PGPASSWORD=CHANGE_ME_strong_db_password
PGDATABASE=fintech_aeps

# JWT signing secret — MUST be a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=CHANGE_ME_long_random_string

# Run mode for external adapters. `mock` runs with zero credentials.
# Switch to `live` only after wiring real providers (recharge/BBPS/AEPS/DMT/SMS).
APP_MODE=mock

# Web origin(s) allowed to call the API. Set to your domain (comma-separated).
# For same-origin nginx it can stay minimal; include your public URL to be safe.
CORS_ORIGINS=https://your-domain.com,http://localhost:8081

# SMS OTP provider: `dev` prints OTP to the API logs; `msg91` for real SMS.
SMS_PROVIDER=dev
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_ID=

# First admin created by the seed — CHANGE the password before first deploy.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Seed demo data (admin + retailer + operators) on first boot only.
# Set true for the FIRST `docker compose up`, then set back to false.
RUN_SEED=true

# ── DEV-ONLY: leave OFF in production ──
# DEV_MASTER_OTP lets a fixed OTP bypass SMS; CAPTCHA_DEV_ECHO logs captcha answers.
# Keep these empty/false in production (real SMS via SMS_PROVIDER=msg91).
DEV_MASTER_OTP=
CAPTCHA_DEV_ECHO=false

# ── Pending transactions / reconciliation ──
# Shared secret the provider uses to sign callbacks. Without it, callbacks are refused
# (pending transactions are still settled by the status-check job).
PROVIDER_CALLBACK_SECRET=CHANGE_ME_long_random_string
JOBS_ENABLED=true
STATUS_CHECK_INTERVAL_SECONDS=300
RECON_HOUR=1
