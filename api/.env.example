# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Run mode for external adapters (KYC, SMS, email). Defaults to "mock" — the app
# runs end-to-end with ZERO external credentials. Set APP_MODE=live to use real
# providers (which must then be configured below). Live mode is opted into here;
# it is never inferred from a key being present.
APP_MODE=mock

# JWT auth (used by the React Native app; replaces cookie sessions)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=8h
JWT_PENDING_TTL=10m

# Web origins allowed to call the API (Expo web dev server). Native apps send no origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# This app does NOT create the database — your setup/provisioning
# script owns that. Point these at whatever DB it creates.
#
# Either set a single DATABASE_URL (takes precedence)...
# DATABASE_URL=postgres://user:password@localhost:5432/fintech_aeps
#
# ...or the discrete PG* variables below:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=fintech_aeps
# Set to "true" if your production DB requires SSL:
PGSSL=false

# ─────────────────────────────────────────────────────────────
# OTP / login policy
# ─────────────────────────────────────────────────────────────
# 6-digit OTP length
OTP_LENGTH=6
# OTP validity in seconds (default 5 minutes)
OTP_TTL_SECONDS=300
# Max number of OTPs a single user may be sent per calendar day
OTP_DAILY_LIMIT=5
# Max wrong-OTP entries allowed per OTP before it is invalidated
OTP_MAX_VERIFY_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────
# SMS provider
#   dev   -> logs OTP to the terminal (no gateway needed)
#   msg91 -> sends via MSG91 (fill in the keys below)
# ─────────────────────────────────────────────────────────────
SMS_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ─────────────────────────────────────────────────────────────
# Seed admin (used by `npm run seed` to create the first admin)
# ─────────────────────────────────────────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FULLNAME=Portal Administrator
SEED_ADMIN_MOBILE=9999999999
SEED_ADMIN_EMAIL=admin@example.com

# Dev-only: echo captcha answers to the log for local testing (keep false in prod)
CAPTCHA_DEV_ECHO=false

# Dev-only: fixed OTP that always works, skips SMS + daily limit (empty=off, ignored in prod)
DEV_MASTER_OTP=

# Per-account brute-force lockout (password step)
LOGIN_MAX_FAILED=5
LOGIN_LOCKOUT_MINUTES=15
