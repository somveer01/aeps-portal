{
  "name": "fintech-aeps-api",
  "version": "0.2.0",
  "private": true,
  "description": "AEPS / fintech portal — JSON API (Express + PostgreSQL, JWT auth) consumed by the React Native (Expo) app.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "seed:make": "knex seed:make",
    "assign-service-icons": "node scripts/assign-service-icons.js",
    "lint": "eslint src",
    "test": "node --test --test-concurrency=1 test/commission.test.js test/api.test.js test/chain.test.js test/network.test.js test/fundRequest.test.js test/guard.test.js"
  },
  "keywords": [
    "aeps",
    "fintech",
    "api",
    "express",
    "postgresql",
    "jwt"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "sharp": "^0.35.4",
    "svg-captcha": "^1.4.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.4"
  }
}
