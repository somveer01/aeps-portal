# Copy to .deploy.env (git-ignored) and fill in YOUR values. Never commit the real file.
# Used by scripts/deploy.sh

# Public IPv4 or DNS name of the EC2 instance (changes on every stop/start without an Elastic IP).
DEPLOY_HOST=CHANGE_ME
# Path to the SSH private key (.pem) for that instance. Keep the key outside the repo.
DEPLOY_KEY=CHANGE_ME
# SSH user (Ubuntu AMI = ubuntu).
DEPLOY_USER=ubuntu
